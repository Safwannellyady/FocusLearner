# =============================================================================
# FocusLearner Pro - Environment Variables Template
#
# HOW TO USE:
#   cp .env.example .env
#   Fill in every value marked <CHANGE_ME> before running docker compose up.
#
# WARNING: Never commit the real .env file to version control.
#          .env is already listed in .gitignore.
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL Database (used by docker-compose to create the db container)
# ---------------------------------------------------------------------------
POSTGRES_DB=focuslearner
POSTGRES_USER=focususer
POSTGRES_PASSWORD=<CHANGE_ME>          # Use a strong, random password

# If running the backend outside of Docker, set this manually:
# DATABASE_URL=postgresql://focususer:<CHANGE_ME>@localhost:5432/focuslearner

# ---------------------------------------------------------------------------
# Flask Security
# ---------------------------------------------------------------------------
SECRET_KEY=<CHANGE_ME>                 # python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<CHANGE_ME>             # python -c "import secrets; print(secrets.token_hex(32))"

# ---------------------------------------------------------------------------
# Flask Runtime (overridden to "production" inside docker-compose)
# ---------------------------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=False
PORT=5000
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# CORS — comma-separated allowed origins
# In Docker: set to your public domain, e.g. https://focuslearner.example.com
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost,http://localhost:3000

# ---------------------------------------------------------------------------
# Google Gemini AI (AI Tutor, Quiz Generation)
# Get key at: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=<CHANGE_ME>
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# YouTube Data API v3
# Get key at: https://console.cloud.google.com ? APIs & Services ? Credentials
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=<CHANGE_ME>

# ---------------------------------------------------------------------------
# Google Custom Search
# ---------------------------------------------------------------------------
GOOGLE_SEARCH_API_KEY=<CHANGE_ME>
GOOGLE_SEARCH_CX=<CHANGE_ME>

# ---------------------------------------------------------------------------
# Google OAuth (Google Sign-In)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=<CHANGE_ME>
GOOGLE_CLIENT_SECRET=<CHANGE_ME>

# ---------------------------------------------------------------------------
# Pinecone Vector Database (RAG / semantic search)
# Get key at: https://app.pinecone.io
# ---------------------------------------------------------------------------
PINECONE_API_KEY=<CHANGE_ME>
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=focuslearner-transcripts
