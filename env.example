# Database Configuration
DATABASE_URL=postgresql://user:password@localhost/focuslearner

# Google Gemini API Key (Required for AI Tutor, Quiz Generation, and Coding Arena)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash

# YouTube API & Google Custom Search (Optional - for video & web material search)
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY
GOOGLE_SEARCH_API_KEY=YOUR_GOOGLE_SEARCH_API_KEY
GOOGLE_SEARCH_CX=YOUR_GOOGLE_SEARCH_CX_ID

# Flask Server & Security Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
HOST=0.0.0.0
SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting Configuration
RATELIMIT_ENABLED=True
RATELIMIT_STORAGE_URL=memory://

# File Upload Configuration
UPLOAD_FOLDER=uploads

# Frontend Configuration
REACT_APP_API_URL=http://localhost:5000/api

# Google OAuth (For Google Sign-In)
GOOGLE_CLIENT_ID=141636012206-oviq8cma0p7pkmvlatc54dia781ov87m.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

