{
  "name": "focuslearner-root",
  "version": "1.0.0",
  "private": true,
  "description": "FocusLearner Monorepo Root",
  "main": "electron/main.js",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --prefix frontend",
    "package-win": "electron-builder --win"
  },
  "build": {
    "appId": "com.focuslearner.app",
    "productName": "FocusLearner Pro",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "electron/icon.png"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "cors": "^2.8.6",
    "react-router-dom": "^7.18.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  }
}
